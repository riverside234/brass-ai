# Keep source and documentation portable between the laptop and lab checkout.
* text=auto
.gitignore text eol=lf
.gitattributes text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.cs text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Frozen original-source snapshots must retain their recorded bytes on every host.
training/opponents/bank/**/source/** -text
# Admission pins metadata bytes, including manifests and selection receipts.
# Existing LF checkouts are accepted only via newline-equivalent verification.
training/opponents/bank/**/manifest.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
training/opponents/evaluations/**/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Contract/profile files are byte-pinned; preserve the same bytes on the lab.
configs/**/*.json -text
training/models/**/*.pt -text
training/models/**/*.onnx -text
training/runtime/**/*.exe -text
training/runtime/**/*.json -text
