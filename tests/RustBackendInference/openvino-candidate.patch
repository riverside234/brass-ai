+#[test]
+fn provider_pins_reject_precision_threads_unknown_versions_and_path_escapes() {
+    use brass_ai_inference::manifest::{ProviderRuntime, RuntimeFile, OPENVINO_CONFIG};
+    let mut m = manifest();
+    m.runtime_version = "1.31.0".into();
+    m.binding_version = "2.0.0-rc.13".into();
+    m.provider = "OpenVINOExecutionProvider".into();
+    m.provider_runtime = Some(ProviderRuntime {
+        plugin_version: "1.8.1".into(),
+        openvino_version: "2026.4.1-22982-e213a147257".into(),
+        library: "openvino/plugin.dll".into(),
+        files: vec![RuntimeFile {
+            path: "openvino/plugin.dll".into(),
+            sha256: "0".repeat(64),
+        }],
+        options: [("load_config".into(), OPENVINO_CONFIG.into())].into(),
+        allow_cpu_fallback: true,
+    });
+    m.validate().unwrap();
+    for mutation in 0..7 {
