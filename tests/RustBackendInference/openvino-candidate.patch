@@ -0,0 +1,190 @@
+//! Pinned CPU providers. Plugin registration is process-wide; sessions remain
+//! owner-local. A fallback is only a startup decision, never a mid-search retry.
+use crate::{invalid, manifest::Bundle, require, Result};
+use ort::{
+    environment::Environment,
+    ep::ExecutionProviderLibrary,
+    memory::DeviceType,
+    session::{
+        builder::{GraphOptimizationLevel, SessionBuilder},
+        Session,
+    },
+};
+use serde::Serialize;
+use std::sync::OnceLock;
+
+static RUNTIME: OnceLock<std::result::Result<String, String>> = OnceLock::new();
+static PLUGIN: OnceLock<std::result::Result<(String, ExecutionProviderLibrary), String>> =
+    OnceLock::new();
+
+pub(crate) fn error(e: impl std::fmt::Display) -> brass_ai_core::CoreError {
+    invalid(format!("ONNX runtime: {e}"))
+}
+#[derive(Clone, Serialize)]
+pub struct Receipt {
+    pub requested: String,
+    pub effective: String,
+    pub override_reason: Option<String>,
+    pub fallback_reason: Option<String>,
+    pub options: std::collections::BTreeMap<String, String>,
+    pub plugin_version: Option<String>,
+    pub openvino_version: Option<String>,
+    pub device: String,
+    pub cpu_partition_fallback_disabled: bool,
+}
+
+fn builder() -> Result<SessionBuilder> {
+    Session::builder()
+        .map_err(error)?
+        .with_no_environment_execution_providers()
+        .map_err(error)?
+        .with_intra_threads(1)
+        .map_err(error)?
+        .with_inter_threads(1)
+        .map_err(error)?
+        .with_parallel_execution(false)
+        .map_err(error)?
+        .with_intra_op_spinning(false)
+        .map_err(error)?
+        .with_inter_op_spinning(false)
+        .map_err(error)?
+        // rc.10 called ORT_ENABLE_ALL "Level3"; rc.13 gives it the explicit
+        // "All" name. Keep numeric ORT_ENABLE_ALL=99 for the 1.22.1 baseline.
+        .with_optimization_level(GraphOptimizationLevel::All)
+        .map_err(error)?
+        .with_config_entry("optimization.enable_gelu_approximation", "0")
+        .map_err(error)?
+        .with_log_level(ort::logging::LogLevel::Error)
+        .map_err(error)
+}
+
+pub fn create(bundle: &Bundle) -> Result<(Session, Receipt)> {
+    require(bundle.manifest.runtime_version == "1.31.0", "experimental plugin binding requires ORT 1.31.0; use the frozen rc.10 executable for the 1.22.1 control")?;
+    let runtime_key = &bundle.manifest.runtime_sha256;
+    let initialized = RUNTIME.get_or_init(|| {
+        let env = ort::init_from(&bundle.runtime_path).map_err(|e| e.to_string())?;
+        if !env.with_name("brass-cpu").with_telemetry(false).commit() {
+            return Err("runtime was initialized before pinned admission".into());
+        }
+        Environment::current().map_err(|e| e.to_string())?;
+        Ok(runtime_key.clone())
+    });
+    require(
+        initialized
+            .as_ref()
+            .map(|k| k == runtime_key)
+            .unwrap_or(false),
+        "runtime initialization failed or runtime identity changed",
+    )?;
+    let override_value = std::env::var("BRASS_NN_PROVIDER").unwrap_or_default();
+    require(
+        override_value.is_empty() || override_value == "cpu",
+        "invalid BRASS_NN_PROVIDER override",
+    )?;
+    let mut receipt = Receipt {
+        requested: bundle.manifest.provider.clone(),
+        effective: "CPUExecutionProvider".into(),
+        override_reason: (!override_value.is_empty()).then(|| "BRASS_NN_PROVIDER=cpu".into()),
+        fallback_reason: None,
+        options: Default::default(),
+        plugin_version: None,
+        openvino_version: None,
+        device: "CPU".into(),
+        cpu_partition_fallback_disabled: false,
+    };
+    if receipt.requested == "OpenVINOExecutionProvider" && override_value.is_empty() {
+        let p = bundle
+            .manifest
+            .provider_runtime
+            .as_ref()
+            .expect("validated provider");
+        receipt.options = p.options.clone();
+        receipt.plugin_version = Some(p.plugin_version.clone());
+        receipt.openvino_version = Some(p.openvino_version.clone());
+        let attempt = (|| {
+            if let Some(reason) = &bundle.provider_unavailable {
+                return Err(invalid(reason));
+            }
+            let path = bundle
+                .plugin_path
+                .as_ref()
+                .ok_or_else(|| invalid("provider library unavailable"))?;
+            let identity = crate::manifest::hash(&serde_json::to_vec(&p.files).map_err(error)?);
+            let loaded = PLUGIN.get_or_init(|| {
+                let env = Environment::current().map_err(|e| e.to_string())?;
+                env.register_ep_library("brass_openvino", path)
+                    .map(|handle| (identity.clone(), handle))
+                    .map_err(|e| e.to_string())
+            });
+            match loaded {
+                Ok((key, _)) => require(*key == identity, "provider identity changed")?,
+                Err(reason) => {
+                    return Err(invalid(format!("OpenVINO registration failed: {reason}")))
+                }
+            }
+            let env = Environment::current().map_err(error)?;
+            let devices: Vec<_> = env
+                .devices()
+                .filter(|d| {
+                    d.ep().ok() == Some("OpenVINOExecutionProvider")
+                        && d.hardware_device().ty() == DeviceType::CPU
+                })
+                .collect();
+            require(
+                devices.len() == 1,
+                "OpenVINO CPU device unavailable or ambiguous",
+            )?;
+            let options: Vec<_> = p
+                .options
+                .iter()
+                .map(|(k, v)| (format!("OpenVINOExecutionProvider.{k}"), v.clone()))
+                .collect();
+            builder()?
+                .with_devices(devices, Some(&options))
+                .map_err(error)?
+                .with_config_entry("session.disable_cpu_ep_fallback", "1")
+                .map_err(error)?
+                .commit_from_memory(&bundle.model_bytes)
+                .map_err(error)
+        })();
+        match attempt {
+            Ok(session) => {
+                receipt.effective = receipt.requested.clone();
+                receipt.cpu_partition_fallback_disabled = true;
+                return Ok((session, receipt));
+            }
+            Err(e) if p.allow_cpu_fallback => receipt.fallback_reason = Some(e.to_string()),
+            Err(e) => return Err(e),
+        }
+    }
+    // ort rc.13 defaults to automatic selection; its legacy CPU wrapper only
+    // toggles the arena and does NOT disable that policy. On the plugin stack,
+    // explicitly append the built-in CPU device through the V2 API instead.
+    let mut cpu = builder()?;
+    if bundle.manifest.runtime_version == "1.31.0" {
+        let env = Environment::current().map_err(error)?;
+        let devices: Vec<_> = env
+            .devices()
+            .filter(|d| d.ep().ok() == Some("CPUExecutionProvider"))
+            .collect();
+        require(
+            devices.len() == 1,
+            "built-in CPU provider unavailable or ambiguous",
+        )?;
+        cpu = cpu
+            .with_devices(
+                devices,
+                Some(&[("CPUExecutionProvider.use_arena".into(), "1".into())]),
+            )
+            .map_err(error)?;
+    } else {
+        cpu = cpu
+            .with_execution_providers([ort::ep::CPU::default()
+                .with_arena_allocator(true)
+                .build()
+                .error_on_failure()])
+            .map_err(error)?;
+    }
+    let session = cpu.commit_from_memory(&bundle.model_bytes).map_err(error)?;
+    Ok((session, receipt))
+}
