# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

# Windows Installer files from build outputs
*.cab
*.msi
*.msix
*.msm
*.msp

# Brass AI project: this checkout lives inside a Steam game installation.
# Ignore new top-level files/folders by default. Explicitly allow project files
# below so a Steam update or downloaded asset does not become an upload candidate.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/LICENSE.*
!/AGENTS.md
!/pyproject.toml
!/requirements*.txt
!/uv.lock
!/global.json
!/Directory.Build.props
!/Directory.Build.targets
!/Directory.Build.rsp
!/Directory.Packages.props
!/*.sln
!/*.slnx
!/ai-research/
!/rules-audit/
!/src/
!/tests/
!/training/
!/configs/
!/scripts/
!/docs/
!/.github/

# Only authored reports and probe scripts from the inspection folders.
# Decompiled game code, tools, downloaded references and generated results stay local.
/ai-research/*
!/ai-research/simulations/
/ai-research/simulations/*
!/ai-research/simulations/pfsp_sim_original.py
!/ai-research/simulations/PFSP_SIMULATION.md
!/ai-research/FEATURE_ENGINEERING_FE0_CONTRACT.json
!/ai-research/*.md
!/ai-research/*.ps1
/rules-audit/*
!/rules-audit/*.md
!/rules-audit/*.ps1
!/rules-audit/extended-network-matrix.cs
!/rules-audit/reference-review/
/rules-audit/reference-review/*
!/rules-audit/reference-review/*.md
!/rules-audit/reference-review/*.ps1
!/rules-audit/reference-review/*.cs
!/rules-audit/reference-review/*.cjs

# Game installation, extracted code, mod dependencies and local game data.
/BrassBirminghamUnity_Data/
/MonoBleedingEdge/
/BepInEx/
/doorstop_libs/
/steam_appid.txt
**/decompiled/
**/*.verified.cs
/ai-research/tools/
*.dll
*.exe
*.so
*.dylib
*.pdb
*.assets
*.bin
*.assetbundle
*.bundle
*.unity3d
*.sav
*.save
*.zip
*.7z
*.tar
*.tar.gz

# Python environments, caches and local secrets (in allowed project directories too).
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
.coverage
htmlcov/
dist/
build/
.env
.env.*
!.env.example
*.pem
*.key

# Training data, checkpoints and generated experiment output.
checkpoints/
datasets/
replays/
runs/
outputs/
wandb/
mlruns/
tensorboard/
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.h5
*.hdf5
*.npz
*.npy
*.parquet

# Deliberately distributed project-authored bootstrap/release weights.
# Experiments and replay data remain private under artifacts/.
!/training/models/bootstrap/*.pt
!/training/models/releases/
/training/models/releases/*
!/training/models/releases/*.pt
!/training/models/releases/*.onnx
!/training/models/releases/*.json
!/training/models/releases/*.md
# Our original host/policy executables only, not proprietary game DLLs.
!/training/runtime/r1/BrassHost.exe
!/training/runtime/v3/BrassLegacyAI.exe
!/training/runtime/v3-lab/BrassLegacyAI.exe
!/training/runtime/v3-s1-control/BrassLegacyAI.exe
!/training/runtime/v3-masked-control/BrassLegacyAI.exe
!/training/runtime/v3-era-control/BrassLegacyAI.exe
!/training/runtime/v3-industry-control/BrassLegacyAI.exe
!/training/runtime/v3-economy-control/BrassLegacyAI.exe
!/training/runtime/v3-advanced-control/BrassLegacyAI.exe
!/training/runtime/search/BrassHost.exe
!/training/runtime/throughput/ordinary/BrassHost.exe
!/training/runtime/throughput/search/BrassHost.exe
!/training/runtime/local-scoring/ordinary/BrassHost.exe
!/training/runtime/shared-search/*/BrassLegacyAI.exe

# Local operating-system metadata.
/configs/legacy-ai/live.json
.DS_Store
Thumbs.db
Desktop.ini
/.step5-relocation.json

# Generated patch validation data and isolated artificial saves.
/tests/BrassPatch/**/*.rsp
/tests/BrassPatch/**/*.json
/tests/BrassPatch/**/results.txt
/tests/BrassPatch/**/isolated-saves/

# Track results copied from the lab computer.
!/results/
!/results/**

# Explicit checkpoint transfer bundles for local migration tests.
!/test_nn/
!/test_nn/**
/test_nn/**/checkpoint.pt
/test_nn/.staging-*/
/test_nn/**/*.tmp
